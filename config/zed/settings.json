{
  "agent": {
    "default_model": {
      "enable_thinking": false,
      "model": "qwen3-coder:30b",
      "provider": "ollama"
    },
    "dock": "right",
    "favorite_models": [
      {
        "enable_thinking": false,
        "model": "qwen3-coder:30b",
        "provider": "ollama"
      }
    ],
    "message_editor_min_lines": 2,
    "model_parameters": []
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.5"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    }
  },
  "always_treat_brackets_as_autoclosed": true,
  "auto_install_extensions": {
    "fleet-themes": true,
    "html": true,
    "lua": true,
    "make": true,
    "ruby": true,
    "toml": true
  },
  "base_keymap": "Emacs",
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 17.5,
  "buffer_line_height": "comfortable",
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "context_servers": {
    "lean-ctx": {
      "args": [],
      "command": "/auto/home/ekhassan/.local/bin/lean-ctx",
      "env": {}
    }
  },
  "current_line_highlight": "none",
  "cursor_blink": false,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules"
  ],
  "file_types": {
    "Nim": [
      "nim",
      "hpy"
    ]
  },
  "format_on_save": "off",
  "git": {
    "inline_blame": {
      "delay_ms": 300,
      "enabled": true,
      "min_column": 80
    }
  },
  "git_panel": {
    "button": false,
    "collapse_untracked_diff": true,
    "dock": "left",
    "fallback_branch_name": "master"
  },
  "gutter": {
    "folds": true,
    "min_line_number_digits": 0,
    "runnables": false
  },
  "indent_guides": {
    "coloring": "fixed",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "display_name": "Qwen3 Coder 30B",
          "max_tokens": 262144,
          "name": "qwen3-coder:30b"
        }
      ]
    }
  },
  "lsp": {
    "ruff": {
      "binary": {
        "arguments": [
          "check",
          "--stdin-filename",
          "${INPUT_PATH}"
        ],
        "path": "ruff"
      }
    }
  },
  "max_tabs": 8,
  "minimap": {
    "show": "never"
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "notification_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "button": false,
    "dock": "left",
    "indent_size": 35
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "default_width": 350,
    "dock": "right",
    "hide_root": true,
    "indent_guides": {
      "show": "never"
    },
    "starts_open": false,
    "sticky_scroll": false
  },
  "relative_line_numbers": "disabled",
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_workspace",
  "scrollbar": {
    "show": "never"
  },
  "search": {
    "button": true
  },
  "seed_search_query_from_cursor": "never",
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "blinking": "on",
    "copy_on_select": true,
    "default_height": 500,
    "detect_venv": {
      "on": {
        "activate_script": "default",
        "directories": [
          ".venv",
          "venv"
        ]
      }
    },
    "dock": "bottom",
    "env": {
      "EDITOR": "zed --wait"
    },
    "font_family": "Fira Code Symbol",
    "font_size": 17,
    "scrollbar": {
      "show": "always"
    },
    "toolbar": {
      "breadcrumbs": true
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "One Light",
    "mode": "light"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_user_menu": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "ui_font_family": "Droid Sans Mono for Powerline",
  "ui_font_size": 14.5,
  "vim_mode": false
}