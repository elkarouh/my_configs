// Zed keymap — Emacs-style bindings
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-g": "editor::Cancel",
      "ctrl-alt-c": "agent::OpenSettings",
      "shift-left": "workspace::ActivatePaneLeft",
      "shift-right": "workspace::ActivatePaneRight",
      "shift-down": "workspace::ActivatePaneDown",
      "shift-up": "workspace::ActivatePaneUp",
      "escape shift-left": "workspace::SwapPaneLeft",
      "escape shift-right": "workspace::SwapPaneRight",
      "escape shift-up": "workspace::SwapPaneUp",
      "escape shift-down": "workspace::SwapPaneDown",
      "escape %": "pane::SplitRight",
      "escape ! %": "pane::SplitLeft",
      "escape \"": "pane::SplitDown",
      "escape ! \"": "pane::SplitUp"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-g": "editor::Cancel"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-g": "editor::Cancel",
      "ctrl-alt-w": "editor::Cut",
      "ctrl-w": [
        "workspace::SendKeystrokes",
        "ctrl-alt-w ctrl-g"
      ],
      "ctrl-y": "editor::Paste",
      "ctrl-u": "editor::DeleteLine",
      "escape left": "editor::MoveToPreviousSubwordStart",
      "escape right": "editor::MoveToNextSubwordEnd",
      "escape backspace": "editor::DeleteToPreviousSubwordStart",
      "escape delete": "editor::DeleteToNextSubwordEnd",
      "escape /": "editor::ShowCompletions",
      "escape g b": "git::Blame",
      "escape g g": "go_to_line::Toggle",
      "escape m": [
        "editor::MoveToBeginningOfLine",
        {
          "stop_at_soft_wraps": false,
          "stop_at_indent": true
        }
      ],
      "escape f": "editor::MoveToNextSubwordEnd",
      "escape b": "editor::MoveToPreviousSubwordStart",
      "escape u": "editor::ConvertToUpperCase",
      "escape l": "editor::ConvertToLowerCase",
      "escape c": "editor::ConvertToUpperCamelCase",
      "escape ;": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "escape .": "editor::GoToDefinition",
      "escape ,": "pane::GoBack",
      "escape d": "editor::DeleteToNextWordEnd",
      "escape w": [
        "workspace::SendKeystrokes",
        "alt-w ctrl-g"
      ],
      "escape {": "editor::MoveToStartOfParagraph",
      "escape }": "editor::MoveToEndOfParagraph",
      "escape v": "editor::MovePageUp",
      "escape <": "editor::MoveToBeginning",
      "escape >": "editor::MoveToEnd",
      "escape ^": "editor::JoinLines",
      "ctrl-d": ["editor::SelectNext", { "replace_newest": false }]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-g": "editor::Cancel",
      "ctrl-f4": "pane::CloseActiveItem",
      "escape z k": "zed::OpenKeymap",
      "escape z t": "theme_selector::Toggle",
      "escape z s": "zed::OpenSettings",
      "escape z l": "language_selector::Toggle",
      "escape d b": "workspace::ToggleBottomDock",
      "escape d l": "workspace::ToggleLeftDock",
      "escape d r": "workspace::ToggleRightDock",
      "escape p t": "terminal_panel::ToggleFocus",
      "escape p p": "project_panel::ToggleFocus",
      "escape p o": "outline_panel::ToggleFocus",
      "escape p c": "collab_panel::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "d": "project_panel::NewDirectory",
      "ctrl-w": "project_panel::Cut",
      "escape w": "project_panel::Copy",
      "ctrl-y": "project_panel::Paste",
      "r": "project_panel::Rename",
      "f2": "project_panel::Rename",
      "backspace": [
        "project_panel::Trash",
        {
          "skip_prompt": false
        }
      ],
      "delete": [
        "project_panel::Trash",
        {
          "skip_prompt": false
        }
      ],
      "shift-delete": [
        "project_panel::Delete",
        {
          "skip_prompt": false
        }
      ],
      "ctrl-backspace": [
        "project_panel::Delete",
        {
          "skip_prompt": false
        }
      ],
      "ctrl-delete": [
        "project_panel::Delete",
        {
          "skip_prompt": false
        }
      ],
      "ctrl-s": "project_panel::NewSearchInDirectory",
      "ctrl-g": "menu::Cancel",
      "enter": "project_panel::Open",
      "space": "project_panel::Open"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-!": "workspace::ToggleBottomDock",
      "alt-t": "workspace::NewTerminal"
    }
  },
  {
    "bindings": {
      "ctrl-x ctrl-q": "zed::Quit"
    }
  }
]
